<?xml version="1.0" encoding="utf-8"?>
<!--
  Il marchio di Aria: una "a" minuscola a un piano, scritta in un tratto, la cui gamba non si
  ferma ma scivola via in un soffio. E' una lettera, quindi e' sua e di nessun altro assistente; ed
  e' aria, perche' la coda e' quello che fa. Bianco: il colore lo mette il fondo.
  Stesse tre curve di AriaMark.kt (il saluto nella chat) e di ic_tile_aria.xml.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
  <!-- La zona sicura di un'icona adattiva e' il cerchio centrale (raggio 33): la coda arriva a
       x=90 e la maschera tonda la tagliava. Ridotta all'85% e spostata a sinistra ci sta tutta. -->
  <group
      android:scaleX="0.85"
      android:scaleY="0.85"
      android:pivotX="54"
      android:pivotY="54"
      android:translateX="-3">
  <!-- L'anello: centro (46,59), raggio 17, aperto in alto a destra dove arriva la gamba. -->
  <path
      android:pathData="M60.7,50.5 A17,17 0 1 0 51.8,75"
      android:strokeColor="#FFFFFFFF"
      android:strokeWidth="9"
      android:strokeLineCap="round"
      android:fillColor="#00000000" />
  <!-- La gamba, e la coda che se ne va in un soffio. -->
  <path
      android:pathData="M66,42 L66,70 C66,80 78,80 82,72 C85,67 88,63 90,60"
      android:strokeColor="#FFFFFFFF"
      android:strokeWidth="9"
      android:strokeLineCap="round"
      android:strokeLineJoin="round"
      android:fillColor="#00000000" />
  </group>
</vector>
